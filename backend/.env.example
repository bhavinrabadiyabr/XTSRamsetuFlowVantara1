# Copy to backend/.env and fill in values.
# DeltaX OMS (Vantara2). Hostlookup is {XTS_ROOT}/hostlookup.
# Market data REST is {XTS_ROOT}/apibinarymarketdata.
XTS_ROOT=http://oms.deltaxbroking.com:3000
XTS_MD_ROOT=http://oms.deltaxbroking.com:3000
XTS_OPERATOR_ID=BIZ09
XTS_USER_ID=BIZ09
XTS_USER_PASSWORD=
XTS_LOGIN_USER=Vantara02
XTS_LOGIN_PASSWORD=
XTS_IX_APP_KEY=
XTS_IX_APP_SECRET=
XTS_MD_APP_KEY=
XTS_MD_APP_SECRET=
XTS_ALGO_ID=
XTS_ALGO_NAME=
# Optional mapped client. Leave empty to use clientCodes from the session login.
# XTS_CLIENT_ID=
# Live LTP SSE: coalesce ms (default 16). Set 0 for max tick rate (higher CPU).
# XTS_MD_COALESCE_MS=16
# Dhan 1-minute Nifty 50 candles for the Nifty Wish VWAP (IDX_I security 13)..
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
MORNING_SENTIMENT_SCHEDULE=08:00
