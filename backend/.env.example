# Copy to backend/.env and fill in values
# Symphony / XTS gateway (direct :3000 host, or a hostlookup load balancer)
XTS_ROOT=http://127.0.0.1:3000
XTS_MD_ROOT=http://127.0.0.1:3000
XTS_OPERATOR_ID=SANKALP
XTS_LOGIN_USER=
XTS_LOGIN_PASSWORD=
XTS_IX_APP_KEY=
XTS_IX_APP_SECRET=
XTS_MD_APP_KEY=
XTS_MD_APP_SECRET=
XTS_ALGO_ID=
XTS_ALGO_NAME=
# Optional mapped client. Leave empty to use clientCodes from the session login.
# XTS_CLIENT_ID=
# Live LTP SSE: coalesce ms (default 16). Set 0 for max tick rate (higher CPU).
# XTS_MD_COALESCE_MS=16
# Dhan 1-minute Nifty 50 candles for the Nifty Wish VWAP (IDX_I security 13)..
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
MORNING_SENTIMENT_SCHEDULE=08:00
